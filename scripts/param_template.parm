# PX4 参数模板 — 四旋翼基础调参
# 使用方法: 在 QGroundControl 中导入, 或通过 MAVLink 加载

# ============================================================
# 角速率环 (内环)
# ============================================================

# 滚转角速率
MC_ROLLRATE_P,0.15
MC_ROLLRATE_I,0.2
MC_ROLLRATE_D,0.003
MC_ROLLRATE_FF,0.0

# 俯仰角速率
MC_PITCHRATE_P,0.15
MC_PITCHRATE_I,0.2
MC_PITCHRATE_D,0.003
MC_PITCHRATE_FF,0.0

# 偏航角速率
MC_YAWRATE_P,0.2
MC_YAWRATE_I,0.1
MC_YAWRATE_D,0.0
MC_YAWRATE_FF,0.0

# ============================================================
# 姿态环 (中环)
# ============================================================

MC_ROLL_P,6.5
MC_PITCH_P,6.5
MC_YAW_P,2.8
MC_YAW_WEIGHT,0.4

# ============================================================
# 位置环 (外环)
# ============================================================

# 水平位置
MPC_XY_P,0.8
MPC_XY_VEL_P_ACC,1.8
MPC_XY_VEL_I_ACC,0.4
MPC_XY_VEL_D_ACC,0.2

# 垂直位置
MPC_Z_P,1.0
MPC_Z_VEL_P_ACC,4.0
MPC_Z_VEL_I_ACC,2.0
MPC_Z_VEL_D_ACC,0.0

# 速度限制
MPC_XY_VEL_MAX,12.0
MPC_Z_VEL_MAX_UP,3.0
MPC_Z_VEL_MAX_DN,1.0

# ============================================================
# 推力模型
# ============================================================

THR_MDL_FAC,0.3
MPC_THR_HOVER,0.5
MPC_THR_MAX,1.0
MPC_THR_MIN,0.12

# ============================================================
# 电池
# ============================================================

BAT_N_CELLS,4
BAT_V_EMPTY,3.5
BAT_V_FULL,4.2
BAT_LOW_THR,0.2
BAT_CRIT_THR,0.07

# ============================================================
# EKF2
# ============================================================

EKF2_IMU_NOISE,0.01
EKF2_GPS_DELAY,110
EKF2_GPS_POS_X,0.0
EKF2_GPS_POS_Y,0.0
EKF2_GPS_POS_Z,0.0

# ============================================================
# 安全
# ============================================================

COM_OBL_ACT,1
COM_OBL_RC_ACT,0
COM_RC_IN_MODE,0
COM_RC_LOSS_T,1.0
GF_ACTION,1
GF_MAX_HOR_DIST,500
GF_MAX_VER_DIST,100
